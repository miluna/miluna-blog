---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { translations } from '../data/translations';

interface Props {
  title?: string;
  description?: string;
}

const isSpanish = Astro.url.pathname.startsWith('/es') || Astro.url.pathname.includes('/es/');
const lang = isSpanish ? 'es' : 'en';
const t = translations[lang];

// Set localized defaults for title and description if not provided
const defaultTitle = t.layoutDefaultTitle;
const defaultDescription = t.layoutDefaultDescription;

const displayTitle = Astro.props.title || defaultTitle;
const displayDescription = Astro.props.description || defaultDescription;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
    <meta name="description" content={displayDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#FDFDFD] text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">
    <Header />

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  h1, h2, h3, h4, .font-display {
    font-family: var(--font-display);
  }
  
  body {
    font-family: var(--font-sans);
  }
</style>
