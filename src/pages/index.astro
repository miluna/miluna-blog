---
import { getCollection } from 'astro:content';
import LogoCarousel from '../components/LogoCarousel.astro';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog');
// Sort posts by pubDate descending, take the top 3
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Miluna Cloud | Microservicios (Spring Boot & FastAPI), AWS & Kubernetes">
  <!-- Hero Section -->
  <section class="relative pt-20 pb-16 overflow-hidden">
    <!-- Soft light background glows -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-100/60 rounded-full blur-3xl -z-10"></div>
    <div class="absolute top-1/4 right-1/4 w-[400px] h-[400px] bg-purple-100/50 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-xs font-semibold tracking-wide text-emerald-800 mb-8 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Disponible para proyectos Backend, Cloud AWS & Agentes de IA
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 max-w-4xl mx-auto leading-[1.15]">
        Microservicios Backend <br class="hidden sm:inline" />
        <span class="block text-slate-900">&</span>
        <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-800 bg-clip-text text-transparent">
          Arquitectura Cloud
        </span>
      </h1>

      <!-- Description -->
      <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
        Servicios de ingeniería senior por <strong class="text-slate-900 font-semibold">Miguel Ángel Luna</strong>. Especializado en desarrollo de microservicios con <span class="text-slate-900 font-semibold">Spring Boot & FastAPI</span>, despliegues sobre <span class="text-slate-900 font-semibold">AWS y Kubernetes</span>, creación de <span class="text-slate-900 font-semibold">Agentes de IA y Servidores MCP</span>, y <span class="text-slate-900 font-semibold">migraciones RDS Aurora sin caída de servicio</span>.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
        <a href="mailto:miguel.luna@milunacloud.com" class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-indigo-600 text-white font-semibold rounded-xl transition-all shadow-sm hover:shadow-md text-center">
          Contactar
        </a>
        <a href="/about" class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold rounded-xl transition-all shadow-xs text-center">
          Saber más
        </a>
      </div>

      <!-- Logo Carousel under Title and Description -->
      <LogoCarousel />
    </div>
  </section>

  <!-- Specializations / Main Capabilities Grid -->
  <section class="py-20 border-y border-slate-200/80 bg-slate-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2 block">Dominio Técnico</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Especialización & Capacidades Core</h2>
        <p class="text-slate-600 max-w-2xl mx-auto mt-3 text-sm sm:text-base">
          Ingeniería de vanguardia enfocada en microservicios resilientes, infraestructura distribuida y automatización avanzada con IA.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Desarrollo Cloud</h3>
            <p class="text-slate-600 text-xs leading-relaxed">Microservicios robustos en Spring Boot y APIs asíncronas con FastAPI. Orquestación de contenedores (K8s/ECS), serverless y streaming Kafka.</p>
          </div>
          <a href="/about#contact" class="mt-4 text-xs font-bold text-emerald-600 hover:text-emerald-800">Contratar &rarr;</a>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Agentes de IA & MCP</h3>
            <p class="text-slate-600 text-xs leading-relaxed">Automatización de resolución de incidencias en producción mediante servidores MCP.</p>
          </div>
          <a href="/about#contact" class="mt-4 text-xs font-bold text-indigo-600 hover:text-indigo-800">Contratar &rarr;</a>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Pasarelas de pagos</h3>
            <p class="text-slate-600 text-xs leading-relaxed">Integración con Stripe, Paypal y Adyen.</p>
          </div>
          <a href="/about#contact" class="mt-4 text-xs font-bold text-blue-600 hover:text-blue-800">Contratar &rarr;</a>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Migraciones & FinOps</h3>
            <p class="text-slate-600 text-xs leading-relaxed">Migraciones RDS Aurora zero-downtime y optimización de costes cloud.</p>
          </div>
          <a href="/about#contact" class="mt-4 text-xs font-bold text-purple-600 hover:text-purple-800">Contratar &rarr;</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Recent Articles -->
  <section class="py-16 border-t border-slate-200/80 bg-slate-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2 block">Publicaciones Técnicas</span>
          <h2 class="text-3xl font-extrabold text-slate-900">Artículos de Ingeniería</h2>
        </div>
        <a href="/blog" class="text-xs font-bold uppercase tracking-wider text-indigo-600 hover:text-indigo-800 transition-colors inline-flex items-center gap-1">
          Ver todos los artículos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <article class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-1 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase text-indigo-700 bg-indigo-50 border border-indigo-100 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 line-clamp-2 group-hover:text-indigo-600 transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="text-slate-600 text-sm line-clamp-3 mb-6 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-100">
              <span>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <a href={`/blog/${post.id}`} class="text-indigo-600 hover:text-indigo-800 font-bold inline-flex items-center gap-1">
                Leer
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white relative overflow-hidden shadow-xl">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
      <div class="relative z-10 max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 block">¿Tienes un proyecto Backend, Cloud o de Agentes de IA?</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold mb-4 leading-tight">Resolvamos retos operativos.</h2>
        <p class="text-slate-300 mb-8 text-sm sm:text-base leading-relaxed">
          Desde microservicios en Spring Boot & FastAPI desplegados en AWS/Kubernetes, hasta migraciones sin caída en RDS Aurora y automatizaciones avanzadas con Agentes de IA.
        </p>
        <a href="mailto:miguel.luna@milunacloud.com" class="inline-block px-7 py-3.5 bg-white text-slate-900 font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-md">
          Contactar
        </a>
      </div>
    </div>
  </section>
</Layout>
