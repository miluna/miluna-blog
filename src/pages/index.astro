---
// Root page: redirect to localized version (/en/ or /es/)
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Miluna Cloud Services</title>
    <meta http-equiv="refresh" content="0;url=/en/" />
    <script is:inline>
      (function() {
        const storedLang = localStorage.getItem('preferred-lang');
        if (storedLang === 'es') {
          window.location.replace('/es/');
          return;
        }
        if (storedLang === 'en') {
          window.location.replace('/en/');
          return;
        }
        const browserLang = navigator.language || '';
        if (browserLang.startsWith('es')) {
          window.location.replace('/es/');
        } else {
          window.location.replace('/en/');
        }
      })();
    </script>
  </head>
  <body class="bg-[#FDFDFD] text-slate-700 flex items-center justify-center min-h-screen">
    <p class="text-sm">Redirecting to <a href="/en/" class="text-indigo-600 underline">Miluna Cloud</a>...</p>
  </body>
</html>
