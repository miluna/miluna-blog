---
import Layout from '../layouts/Layout.astro';
import CaseStudyCard from '../components/case-studies/CaseStudyCard.astro';
import ContactCTA from '../components/common/ContactCTA.astro';
import { translations } from '../data/translations';

const lang = 'en';
const t = translations[lang];
---

<Layout
  title={`${t.caseStudiesHeaderTitle} | Miluna Cloud Services`}
  description={t.caseStudiesHeaderDesc}
>
  <div class="relative py-16 overflow-hidden">
    <!-- Background glows -->
    <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-indigo-50/80 rounded-full blur-3xl -z-10"></div>
    <div class="absolute top-1/2 right-1/4 w-[400px] h-[400px] bg-purple-50/60 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100/80 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
          <span class="text-xs font-semibold text-indigo-900 uppercase tracking-wider">
            {t.caseStudiesHeaderBadge}
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold font-display text-slate-900 tracking-tight leading-tight">
          {t.caseStudiesHeaderTitle}
        </h1>
        <p class="text-lg text-slate-600 font-normal leading-relaxed">
          {t.caseStudiesHeaderDesc}
        </p>
      </div>

      <!-- Structured Mosaic Grid of Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {t.caseStudiesList.map((item) => (
          <CaseStudyCard lang={lang} item={item} />
        ))}
      </div>

      <!-- Contact CTA -->
      <div id="contact">
        <ContactCTA lang={lang} />
      </div>
    </div>
  </div>
</Layout>
