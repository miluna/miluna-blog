---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
// Sort posts by publication date descending
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags for quick filtering links
const allTags = [...new Set(posts.flatMap(post => post.data.tags))];

const description = "Perspectivas de ingeniería, análisis en profundidad y reflexiones sobre escalabilidad, cómputo distribuido y sistemas de misión crítica.";
---

<Layout title="Engineering Blog | Miluna Cloud Services" description={description}>
  <div class="relative py-16 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Title & Intro -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2 block">Publicaciones Técnicas</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">Engineering Blog</h1>
        <p class="text-lg text-slate-600">
          {description}
        </p>
      </div>

      <!-- Main Layout: Sidebar Tags + Articles list -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <!-- Sidebar tags -->
        <div class="lg:col-span-1 space-y-6">
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Filtrar por Tema</h2>
            <div class="flex flex-wrap lg:flex-col gap-2" id="tag-filters-container">
              <button 
                type="button"
                data-tag="all"
                class="tag-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white cursor-pointer transition-all text-center lg:text-left block w-full"
              >
                Todos los Temas ({posts.length})
              </button>
              {allTags.map((tag) => (
                <button 
                  type="button"
                  data-tag={tag}
                  class="tag-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 cursor-pointer transition-all text-center lg:text-left block w-full"
                >
                  {tag}
                </button>
              ))}
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900 text-white shadow-sm">
            <h3 class="text-sm font-bold text-white mb-2">¿Asesoría Especializada?</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Optimización de infraestructura, compiladores C++, sistemas distribuidos y arquitectura en la nube.
            </p>
            <a href="mailto:miluna1994@gmail.com" class="inline-block text-xs font-bold text-indigo-300 hover:text-white transition-colors">
              Contactar &rarr;
            </a>
          </div>
        </div>

        <!-- Articles list -->
        <div class="lg:col-span-3 space-y-8">
          <div id="no-posts-msg" class="hidden text-center py-20 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
            <p class="text-slate-600 font-medium">No se encontraron artículos para este tema seleccionado.</p>
          </div>

          {sortedPosts.length === 0 ? (
            <div class="text-center py-20 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
              <p class="text-slate-600">Todavía no hay posts publicados. ¡Vuelve pronto!</p>
            </div>
          ) : (
            sortedPosts.map((post) => (
              <article 
                data-tags={JSON.stringify(post.data.tags)}
                class="post-card p-8 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all group flex flex-col md:flex-row md:items-center gap-6"
              >
                <!-- Text contents -->
                <div class="flex-grow">
                  <div class="flex flex-wrap items-center gap-3 mb-3 text-xs text-slate-500">
                    <span>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span>Por {post.data.author}</span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-indigo-600 transition-colors">
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h2>

                  <p class="text-slate-600 text-sm leading-relaxed mb-6 max-w-3xl">
                    {post.data.description}
                  </p>

                  <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100">
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <button 
                          type="button"
                          data-tag={tag}
                          class="tag-filter-btn px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase text-slate-600 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 border border-slate-200 rounded transition-colors cursor-pointer"
                        >
                          {tag}
                        </button>
                      ))}
                    </div>

                    <a href={`/blog/${post.id}`} class="text-indigo-600 group-hover:text-indigo-800 text-sm font-bold inline-flex items-center gap-1.5 transition-colors">
                      Leer Artículo
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initTagFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const postCards = document.querySelectorAll<HTMLElement>('.post-card');
    const emptyState = document.getElementById('no-posts-msg');

    if (!filterBtns.length || !postCards.length) return;

    function filterPosts(selectedTag: string) {
      let visibleCount = 0;

      filterBtns.forEach(btn => {
        const btnTag = btn.getAttribute('data-tag');
        const isSelected = btnTag === selectedTag;

        // Only toggle main sidebar buttons styling
        if (btn.parentElement?.id === 'tag-filters-container') {
          if (isSelected) {
            btn.className = 'tag-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white cursor-pointer transition-all text-center lg:text-left block w-full';
          } else {
            btn.className = 'tag-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 cursor-pointer transition-all text-center lg:text-left block w-full';
          }
        }
      });

      postCards.forEach(card => {
        const cardTagsStr = card.getAttribute('data-tags') || '[]';
        let cardTags: string[] = [];
        try {
          cardTags = JSON.parse(cardTagsStr);
        } catch {
          cardTags = [];
        }

        if (selectedTag === 'all' || cardTags.includes(selectedTag)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Sync URL parameter without page refresh
      const url = new URL(window.location.href);
      if (selectedTag === 'all') {
        url.searchParams.delete('tag');
      } else {
        url.searchParams.set('tag', selectedTag);
      }
      window.history.replaceState({}, '', url.toString());
    }

    // Check URL parameters on initial page load
    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get('tag') || 'all';
    filterPosts(initialTag);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = btn.getAttribute('data-tag') || 'all';
        filterPosts(tag);
      });
    });
  }

  // Execute initialization
  initTagFilter();
</script>
