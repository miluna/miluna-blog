---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import BlogSidebar from '../../components/blog/BlogSidebar.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import { translations } from '../../data/translations';

const lang = 'en';
const t = translations[lang];

const posts = await getCollection('blog');
// Filter for English posts only
const enPosts = posts.filter(post => post.id.startsWith('en/'));

// Sort posts by publication date descending
const sortedPosts = enPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags for quick filtering links
const allTags = [...new Set(enPosts.flatMap(post => post.data.tags))];

const description = t.blogDescription;
---

<Layout title="Engineering Blog | Miluna Cloud Services" description={description}>
  <div class="relative py-16 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogHeader lang={lang} title="Engineering Blog" badge="Technical Posts" description={description} />

      <!-- Main Layout: Sidebar Tags + Articles list -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <!-- Sidebar tags -->
        <div class="lg:col-span-1">
          <BlogSidebar lang={lang} tags={allTags} totalPosts={enPosts.length} />
        </div>

        <!-- Articles list -->
        <div class="lg:col-span-3 space-y-8">
          <div id="no-posts-msg" class="hidden text-center py-20 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
            <p class="text-slate-600 font-medium">{t.blogNoPosts}</p>
          </div>

          {sortedPosts.length === 0 ? (
            <div class="text-center py-20 bg-white rounded-2xl border border-slate-200/80 shadow-xs">
              <p class="text-slate-600">{t.blogEmptyState}</p>
            </div>
          ) : (
            sortedPosts.map((post) => (
              <BlogPostCard lang={lang} post={post} />
            ))
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initTagFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const postCards = document.querySelectorAll<HTMLElement>('.post-card');
    const emptyState = document.getElementById('no-posts-msg');

    if (!filterBtns.length || !postCards.length) return;

    function filterPosts(selectedTag: string) {
      let visibleCount = 0;

      filterBtns.forEach(btn => {
        const btnTag = btn.getAttribute('data-tag');
        const isSelected = btnTag === selectedTag;

        // Only toggle main sidebar buttons styling
        if (btn.parentElement?.id === 'tag-filters-container') {
          if (isSelected) {
            btn.className = 'tag-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white cursor-pointer transition-all text-center lg:text-left block w-full';
          } else {
            btn.className = 'tag-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 cursor-pointer transition-all text-center lg:text-left block w-full';
          }
        }
      });

      postCards.forEach(card => {
        const cardTagsStr = card.getAttribute('data-tags') || '[]';
        let cardTags: string[] = [];
        try {
          cardTags = JSON.parse(cardTagsStr);
        } catch {
          cardTags = [];
        }

        if (selectedTag === 'all' || cardTags.includes(selectedTag)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Sync URL parameter without page refresh
      const url = new URL(window.location.href);
      if (selectedTag === 'all') {
        url.searchParams.delete('tag');
      } else {
        url.searchParams.set('tag', selectedTag);
      }
      window.history.replaceState({}, '', url.toString());
    }

    // Check URL parameters on initial page load
    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get('tag') || 'all';
    filterPosts(initialTag);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = btn.getAttribute('data-tag') || 'all';
        filterPosts(tag);
      });
    });
  }

  // Execute initialization
  initTagFilter();
</script>
