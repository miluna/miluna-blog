---
import { translations, type MultilingualProps } from '../../data/translations';

interface Props extends MultilingualProps {}

const { lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const t = translations[lang];
---

<div class="bg-white p-8 sm:p-10 rounded-2xl border border-slate-200/80 shadow-xs mb-16 space-y-4 text-slate-700 leading-relaxed">
  <p class="text-base sm:text-lg" set:html={t.bioPara1} />
  <p class="text-sm sm:text-lg text-slate-600" set:html={t.bioPara2} />
</div>
