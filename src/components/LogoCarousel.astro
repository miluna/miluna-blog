---
import { translations, type MultilingualProps } from '../data/translations';

interface Props extends MultilingualProps {}

const { lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const t = translations[lang];

// Client company logos & tech stack tailored to Cloud, Frameworks, AI & Automotive
const clientLogos = [
  { name: "Juguetronica", category: "E-commerce & Marketplaces", icon: "juguetronica" },  
  { name: "Escuela CEV", category: "Education", icon: "cev" },
  { name: "Klarna", category: "E-commerce FinTech", icon: "klarna" },
  { name: "Openbank", category: "Banking Systems", icon: "openbank" },
  { name: "Daimler", category: "Automotive", icon: "daimler" },
  { name: "Sopra HR", category: "HR Tech", icon: "sopra-hr" },
  { name: "Oru Studio", category: "Video Games & Media", icon: "oru" },
  { name: "Aechelon Technology", category: "Government & Defense Simulators", icon: "aechelon" },
];

// Duplicate array to ensure infinite loop seamlessly
const doubleLogos = [...clientLogos, ...clientLogos];
---

<div class="w-full pt-10 pb-4">
  <div class="text-center mb-6">
    <p class="text-[11px] font-bold tracking-widest uppercase text-slate-600">
      {t.featuredCompanies}
    </p>
  </div>

  <!-- Carousel outer container with fade masks -->
  <div class="relative w-full overflow-hidden py-3">
    <!-- Gradient Fade Masks -->
    <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-[#FDFDFD] via-[#FDFDFD]/80 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-[#FDFDFD] via-[#FDFDFD]/80 to-transparent z-10 pointer-events-none"></div>

    <!-- Animated marquee track -->
    <div class="animate-marquee gap-8 sm:gap-12 items-center">
      {doubleLogos.map((client) => (
        <div class="flex items-center gap-3.5 px-4 py-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs hover:border-indigo-300 hover:shadow-sm transition-all group shrink-0">
          <div class="w-9 h-9 rounded-lg bg-slate-100 border border-slate-200/80 flex items-center justify-center overflow-hidden shrink-0">
            <img 
              src={`/${client.icon}.webp`} 
              alt={client.name} 
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden'); this.nextElementSibling.classList.add('flex');"
            />
            <span class="hidden w-full h-full items-center justify-center font-display font-bold text-[10px] text-slate-800 uppercase bg-slate-900 text-white rounded">
              {client.icon.slice(0, 2)}
            </span>
          </div>
          <div class="flex flex-col text-left">
            <span class="text-xs font-bold text-slate-800 tracking-tight group-hover:text-slate-900">
              {client.name}
            </span>
            <span class="text-[10px] text-slate-500 font-medium tracking-wide">
              {client.category}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
