---
import type { CollectionEntry } from 'astro:content';
import { translations } from '../../data/translations';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang?: 'en' | 'es';
}

const { posts, lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const isSpanish = lang === 'es';
const t = translations[lang];
---

<section class="py-16 border-t border-slate-200/80 bg-slate-50/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2 block">
          {t.technicalPublications}
        </span>
        <h2 class="text-3xl font-extrabold text-slate-900">
          {t.engineeringArticles}
        </h2>
      </div>
      <a href={isSpanish ? "/es/blog" : "/blog"} class="text-xs font-bold uppercase tracking-wider text-indigo-600 hover:text-indigo-800 transition-colors inline-flex items-center gap-1">
        {t.viewAllArticles}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => {
        const idWithoutPrefix = post.id.replace(/^(en|es)\//, '');
        const href = isSpanish ? `/es/blog/${idWithoutPrefix}` : `/blog/${idWithoutPrefix}`;

        return (
          <article class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-1 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase text-indigo-700 bg-indigo-50 border border-indigo-100 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 line-clamp-2 group-hover:text-indigo-600 transition-colors">
                <a href={href}>{post.data.title}</a>
              </h3>
              <p class="text-slate-600 text-sm line-clamp-3 mb-6 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-100">
              <span>{post.data.pubDate.toLocaleDateString(isSpanish ? 'es-ES' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <a href={href} class="text-indigo-600 hover:text-indigo-800 font-bold inline-flex items-center gap-1">
                {t.read}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
