---
import { BOOKING_URL } from '../../data/contact';
import { translations, type MultilingualProps } from '../../data/translations';

interface Props extends MultilingualProps {
  tags: string[];
  totalPosts: number;
}

const { lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en', tags, totalPosts } = Astro.props;
const t = translations[lang];
---

<div class="space-y-6">
  <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
    <button
      type="button"
      id="filter-dropdown-toggle"
      aria-expanded="false"
      aria-controls="tag-filters-container"
      class="w-full flex items-center justify-between text-xs font-bold text-slate-900 uppercase tracking-wider cursor-pointer select-none focus:outline-hidden"
    >
      <span class="flex items-center gap-1.5">
        <span>{t.filterByTopic}</span>
        <span id="active-filter-count" class="hidden text-slate-500 font-semibold text-xs font-mono"></span>
      </span>
      <svg
        id="filter-dropdown-chevron"
        class="w-4 h-4 text-slate-500 transition-transform duration-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div class="hidden mt-4 flex flex-wrap lg:flex-col gap-2" id="tag-filters-container">
      <button 
        type="button"
        data-tag="all"
        class="tag-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white cursor-pointer transition-all text-center lg:text-left block w-full"
      >
        {t.allTopics} ({totalPosts})
      </button>
      {tags.map((tag) => (
        <button 
          type="button"
          data-tag={tag}
          class="tag-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 cursor-pointer transition-all text-center lg:text-left block w-full"
        >
          {tag}
        </button>
      ))}
    </div>
  </div>

  <div class="p-6 rounded-2xl bg-slate-900 text-white shadow-sm">
    <h3 class="text-sm font-bold text-white mb-2">
      {t.specializedConsulting}
    </h3>
    <p class="text-xs text-slate-300 leading-relaxed mb-4">
      {t.consultingAdDesc}
    </p>
    <a href={BOOKING_URL} class="inline-block text-xs font-bold text-indigo-300 hover:text-white transition-colors">
      {t.contactMeArrow}
    </a>
  </div>
</div>
