---
interface Props {
  title?: string;
  badge?: string;
  description?: string;
}

const {
  title = "Engineering Blog",
  badge = "Publicaciones Técnicas",
  description = "Perspectivas de ingeniería, análisis en profundidad y reflexiones sobre escalabilidad, cómputo distribuido y sistemas de misión crítica."
} = Astro.props;
---

<div class="text-center max-w-3xl mx-auto mb-16">
  <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2 block">{badge}</span>
  <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{title}</h1>
  <p class="text-lg text-slate-600">
    {description}
  </p>
</div>
