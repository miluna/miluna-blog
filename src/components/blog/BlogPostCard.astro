---
import type { CollectionEntry } from 'astro:content';
import { translations, type MultilingualProps } from '../../data/translations';

interface Props extends MultilingualProps {
  post: CollectionEntry<'blog'>;
}

const { post, lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const isSpanish = lang === 'es';
const t = translations[lang];

const idWithoutPrefix = post.id.replace(/^(en|es)\//, '');
const href = isSpanish ? `/es/blog/${idWithoutPrefix}` : `/blog/${idWithoutPrefix}`;
---

<article 
  data-tags={JSON.stringify(post.data.tags)}
  class="post-card p-8 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all group flex flex-col md:flex-row md:items-center gap-6"
>
  <div class="flex-grow">
    <div class="flex flex-wrap items-center gap-3 mb-3 text-xs text-slate-500">
      <span>{post.data.pubDate.toLocaleDateString(isSpanish ? 'es-ES' : 'en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span class="w-1 h-1 rounded-full bg-slate-300"></span>
      <span>{t.byAuthor} {post.data.author}</span>
    </div>

    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-indigo-600 transition-colors">
      <a href={href}>{post.data.title}</a>
    </h2>

    <p class="text-slate-600 text-sm leading-relaxed mb-6 max-w-3xl">
      {post.data.description}
    </p>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100">
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <button 
            type="button"
            data-tag={tag}
            class="tag-filter-btn px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase text-slate-600 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 border border-slate-200 rounded transition-colors cursor-pointer"
          >
            {tag}
          </button>
        ))}
      </div>

      <a href={href} class="text-indigo-600 group-hover:text-indigo-800 text-sm font-bold inline-flex items-center gap-1.5 transition-colors">
        {t.readArticle}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
