---
interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  description?: string;
  buttonText?: string;
  email?: string;
}

const {
  title = "Resolvamos retos operativos.",
  badge = "¿Tienes un proyecto Backend, Cloud o de Agentes de IA?",
  description = "Desde microservicios en Spring Boot & FastAPI desplegados en AWS/Kubernetes, hasta migraciones sin caída en RDS Aurora y automatizaciones avanzadas con Agentes de IA.",
  buttonText = "Contactar",
  email = "miluna1994@gmail.com"
} = Astro.props;
---

<section class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white relative overflow-hidden shadow-xl">
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
    <div class="relative z-10 max-w-2xl">
      {badge && <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 block">{badge}</span>}
      <h2 class="text-2xl sm:text-4xl font-extrabold mb-4 leading-tight">{title}</h2>
      <p class="text-slate-300 mb-8 text-sm sm:text-base leading-relaxed">
        {description}
      </p>
      <a href={`mailto:${email}`} class="inline-block px-7 py-3.5 bg-white text-slate-900 font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-md">
        {buttonText}
      </a>
    </div>
  </div>
</section>
