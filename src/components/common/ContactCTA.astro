---
import { CONTACT_EMAIL } from '../../data/contact';
import { translations, type MultilingualProps } from '../../data/translations';

interface Props extends MultilingualProps {
  title?: string;
  subtitle?: string;
  badge?: string;
  description?: string;
  buttonText?: string;
  email?: string;
  class?: string;
}

const { lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const t = translations[lang];

const {
  title = t.contactTitle,
  badge = t.contactBadge,
  description = t.contactDesc,
  buttonText = t.contactMe,
  email = CONTACT_EMAIL,
  class: className = "py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"
} = Astro.props;
---

<section class={className}>
  <div class="p-8 sm:p-10 rounded-3xl bg-slate-900 text-white relative overflow-hidden shadow-xl">
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
    <div class="relative z-10 max-w-2xl">
      {badge && <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 block">{badge}</span>}
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-4 leading-tight">{title}</h2>
      <p class="text-slate-300 mb-8 text-sm sm:text-base leading-relaxed">
        {description}
      </p>
      <a href={`mailto:${email}`} class="inline-block px-7 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition-colors shadow-md">
        {buttonText}
      </a>
    </div>
  </div>
</section>
