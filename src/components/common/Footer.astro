---
import { MAILTO_CONTACT } from '../../data/contact';
import { translations } from '../../data/translations';

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es') || currentPath.includes('/es/');
const lang = isSpanish ? 'es' : 'en';
const t = translations[lang];
---

<footer class="bg-slate-50 border-t border-slate-200/80 py-12 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-7 h-7 rounded-lg bg-slate-900 text-white font-bold text-sm flex items-center justify-center font-display">
            M
          </span>
          <span class="font-bold text-lg tracking-tight text-slate-900">
            Miluna<span class="text-indigo-600 font-semibold">Cloud</span>
          </span>
        </div>
        <p class="text-slate-600 text-sm max-w-sm leading-relaxed">
          {t.footerDesc}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">
          {t.specialties}
        </h3>
        <ul class="space-y-2 text-sm text-slate-600">
          <li><a href={isSpanish ? "/es/about" : "/about"} class="hover:text-indigo-600 transition-colors">{t.specialtyCloud}</a></li>
          <li><a href={isSpanish ? "/es/about" : "/about"} class="hover:text-indigo-600 transition-colors">{t.specialtyAI}</a></li>
          <li><a href={isSpanish ? "/es/about" : "/about"} class="hover:text-indigo-600 transition-colors">{t.specialtyPayments}</a></li>
          <li><a href={isSpanish ? "/es/about" : "/about"} class="hover:text-indigo-600 transition-colors">{t.specialtyMigrations}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">
          {t.navigation}
        </h3>
        <ul class="space-y-2 text-sm text-slate-600">
          <li><a href={isSpanish ? "/es/" : "/"} class="hover:text-indigo-600 transition-colors">{t.home}</a></li>
          <li><a href={isSpanish ? "/es/about" : "/about"} class="hover:text-indigo-600 transition-colors">{t.aboutMiguel}</a></li>
          <li><a href={isSpanish ? "/es/blog" : "/blog"} class="hover:text-indigo-600 transition-colors">{t.blog}</a></li>
          <li><a href={MAILTO_CONTACT} class="hover:text-indigo-600 transition-colors">{t.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} Miluna Cloud Services. {t.allRightsReserved}
      </p>
      <div class="flex gap-6 text-xs text-slate-500 font-medium">
        <span>
          {t.seniorConsultantLine}
        </span>
      </div>
    </div>
  </div>
</footer>
