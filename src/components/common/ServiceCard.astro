---
import type { ServiceItem } from '../../data/services';
import { translations, type Lang } from '../../data/translations';

interface Props {
  service: ServiceItem;
  lang?: Lang;
}

const { service, lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en' } = Astro.props;
const t = translations[lang];
const localizedService = t.services[service.id as keyof typeof t.services];

const colorMap = {
  emerald: {
    bg: 'bg-emerald-50',
    text: 'text-emerald-600'
  },
  indigo: {
    bg: 'bg-indigo-50',
    text: 'text-indigo-600'
  },
  blue: {
    bg: 'bg-blue-50',
    text: 'text-blue-600'
  },
  purple: {
    bg: 'bg-purple-50',
    text: 'text-purple-600'
  }
};

const styles = colorMap[service.badgeColor];
const finalHref = `/${lang}/about`;
---

<a
  href={finalHref}
  class="p-5 sm:p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:border-indigo-200 transition-all flex items-center gap-4 group"
>
  <div class={`w-11 h-11 rounded-xl ${styles.bg} ${styles.text} flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform`}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.iconSvg} />
  </div>
  <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-indigo-600 transition-colors">
    {localizedService.title}
  </h3>
</a>
